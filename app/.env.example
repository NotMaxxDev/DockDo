# DockDo – App-Server
# Kopiere diese Datei nach .env und passe die Werte an.
# WICHTIG: DATA_DIR muss in app/.env UND admin/.env identisch sein (gemeinsame Datenbank).

# Gemeinsames Datenverzeichnis (SQLite-Datei dockdo.db, Backups, Themes)
DATA_DIR=C:/Users/grimm/Desktop/Dev/DockDo/data

# Ports / Host
APP_PORT=3000
ADMIN_PORT=3001
HOST=0.0.0.0

# Sicherheit – unbedingt ändern!
COOKIE_SECRET=anders-langer-zufaelliger-wert

# Öffentlich erreichbare URLs (für Cookies, OIDC-Redirects, Push)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001

# Sitzungen
SESSION_TTL_DAYS=30

# Datenbank: 'sqlite' (Standard) oder 'mariadb'
DB_MODE=sqlite
#MARIADB_HOST=127.0.0.1
#MARIADB_PORT=3306
#MARIADB_DATABASE=todoapp
#MARIADB_USER=todoapp
#MARIADB_PASSWORD=geheim