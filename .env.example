# Erzeugt mit: openssl rand -hex 32
COOKIE_SECRET=change-me-please-use-openssl-rand-hex-32

# sqlite (Standard) oder mariadb
DB_MODE=sqlite

# Externe Ports für die Web-UI
APP_PORT=3000
ADMIN_PORT=3001

PUBLIC_APP_URL=https://localhost:3000
PUBLIC_ADMIN_URL=https://localhost:3001

# Nur relevant bei DB_MODE=mariadb
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=todoapp
MARIADB_USER=todoapp
MARIADB_PASSWORD=change-me-too

# Datenverzeichnis (Host-Pfad, wird auf /data gemountet)
DATA_DIR=./data
