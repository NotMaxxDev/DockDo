# -- Pflicht --
DATA_DIR=./data

# -- Ports (kommentierte Werte = Defaults) --
# APP_PORT=3000
# ADMIN_PORT=3001
# HOST=0.0.0.0

# -- Datenbankmodus: sqlite (Standard) oder mariadb --
# DB_MODE=sqlite

# -- Öffentliche URLs (für OIDC-Redirects, Push, CORS) --
# PUBLIC_APP_URL=http://localhost:3000
# PUBLIC_ADMIN_URL=http://localhost:3001

# -- Sicherheit (UNBEDINGT ÄNDERN) --
COOKIE_SECRET=change-me-to-a-long-random-string
# SESSION_TTL_DAYS=30

# -- MariaDB (nur relevant bei DB_MODE=mariadb, Compose-Profil "mariadb") --
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=todoapp
MARIADB_USER=todoapp
MARIADB_PASSWORD=change-me-too
# MARIADB_HOST=mariadb
# MARIADB_PORT=3306